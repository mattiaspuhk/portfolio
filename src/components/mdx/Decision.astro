---
// A spec table: the options left behind, then the one chosen. The chosen option isn't
// repeated under "Ruled out", so each option shows once.
import { site } from '@/config/site';

interface Props {
  title: string;
  options: string[];
  chose: string;
}

const { title, options, chose } = Astro.props;
const { decision: labels } = site.labels;
const rejected = options.filter((option) => option !== chose);
---

<div class="decision">
  <h3>{title}</h3>
  <dl>
    {
      rejected.length > 0 && (
        <div>
          <dt>{labels.options}</dt>
          <dd class="decision-rejected">
            {rejected.length === 1 ? (
              rejected[0]
            ) : (
              <ul>
                {rejected.map((option) => (
                  <li>{option}</li>
                ))}
              </ul>
            )}
          </dd>
        </div>
      )
    }
    <div>
      <dt>{labels.chose}</dt>
      <dd class="decision-chosen">{chose}</dd>
    </div>
  </dl>
  <slot />
</div>
