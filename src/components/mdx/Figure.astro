---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { site } from '@/config/site';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Marks the screenshot as mock data. Required for GAIA screenshots. */
  mock?: boolean;
}

const { src, alt, caption, mock = false } = Astro.props;
---

<figure>
  <Image src={src} alt={alt} />
  {
    (caption || mock) && (
      <figcaption class="fineprint">
        {mock && <span class="mock-label">{site.labels.mockData}</span>}
        {caption && <span>{caption}</span>}
      </figcaption>
    )
  }
</figure>
