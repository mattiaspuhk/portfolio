---
import MetricFigure from '@/components/work/MetricFigure.astro';

interface Props {
  label: string;
  before?: string;
  after: string;
  note?: string;
}

const { label, before, after, note } = Astro.props;
// Spaced with gaps, not whitespace: Astro drops the line breaks between these spans. The figure is
// a row of its own, so a long label never strands "2" from "80 →".
---

<span class="metric inline-flex flex-wrap items-baseline gap-x-(--space-xs)">
  <span class="text-muted">{label}</span>
  <MetricFigure before={before} after={after} />
  {note && <span class="text-sm text-muted">{note}</span>}
</span>
