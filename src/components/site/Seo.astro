---
import { site } from '@/config/site';
import { canonicalUrl, person, toJsonLd, website, type SchemaNode } from '@/lib/schema';

interface Props {
  title: string;
  description: string;
  /** Path under public/ or an absolute URL. Defaults to og/default.png (1200×630). */
  ogImage?: string;
  /** Alt text and pixel size of ogImage. The default image's size is filled in. */
  ogImageAlt?: string;
  ogImageSize?: { width: number; height: number };
  /** og:type. Case studies are articles; everything else is the website. */
  type?: 'website' | 'article' | 'profile';
  /** Extra schema.org nodes for this page. The Person (and WebSite on home) are always added. */
  jsonLd?: SchemaNode[];
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  ogImageSize,
  type = 'website',
  jsonLd = [],
  noindex = false,
} = Astro.props;

const fullTitle = title === site.name ? site.name : `${title} · ${site.name}`;
const canonical = canonicalUrl(Astro.url);
const image = new URL(ogImage ?? '/og/default.png', Astro.site);
const imageSize = ogImageSize ?? (ogImage ? undefined : { width: 1200, height: 630 });
const isHome = canonical.pathname === '/';

const graph = toJsonLd([await person(), ...(isHome ? [website()] : []), ...jsonLd]);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={site.name} />
{!noindex && <link rel="canonical" href={canonical} />}
<meta
  name="robots"
  content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
/>
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_GB" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
{imageSize && <meta property="og:image:width" content={String(imageSize.width)} />}
{imageSize && <meta property="og:image:height" content={String(imageSize.height)} />}
{ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
{type === 'article' && <meta property="article:author" content={site.url} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
{ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}

<script type="application/ld+json" set:html={graph} />
