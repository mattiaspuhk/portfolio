---
import { Font } from 'astro:assets';
import { site } from '@/config/site';
import Footer from '@/components/site/Footer.astro';
import Header from '@/components/site/Header.astro';
import Seo from '@/components/site/Seo.astro';
import SkipLink from '@/components/site/SkipLink.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Path under public/, e.g. "/og/work.png". */
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, ogImage, noindex } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} ogImage={ogImage} noindex={noindex} />
    <Font cssVariable="--font-body" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-code" />
    <script is:inline>
      // Theme init: set data-theme before first paint. Key must match ThemeToggle.astro.
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <SkipLink label={site.labels.skipLink} />
    <Header currentPath={Astro.url.pathname} />
    <main id="main" tabindex="-1" class="mx-auto w-full max-w-(--page-width) flex-1 px-(--gutter)">
      <slot />
    </main>
    <Footer />
  </body>
</html>
