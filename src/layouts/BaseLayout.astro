---
import { Font } from 'astro:assets';
import { site } from '@/config/site';
import Footer from '@/components/site/Footer.astro';
import Header from '@/components/site/Header.astro';
import Seo from '@/components/site/Seo.astro';
import SkipLink from '@/components/site/SkipLink.astro';
import { canonicalUrl, type SchemaNode } from '@/lib/schema';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Path under public/ (e.g. "/og/work.png") or an absolute URL. */
  ogImage?: string;
  ogImageAlt?: string;
  ogImageSize?: { width: number; height: number };
  type?: 'website' | 'article' | 'profile';
  /** Extra schema.org nodes for this page, see src/lib/schema.ts. */
  jsonLd?: SchemaNode[];
  noindex?: boolean;
}

const { title, description, ogImage, ogImageAlt, ogImageSize, type, jsonLd, noindex } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      ogImageSize={ogImageSize}
      type={type}
      jsonLd={jsonLd}
      noindex={noindex}
    />
    <Font cssVariable="--font-body" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-code" />
    <script is:inline>
      // Theme init: set data-theme before first paint. Key must match ThemeToggle.astro.
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <script is:inline>
      // Clicks during a page transition: newer Chrome sends them to the page root, not the link
      // under the pointer, so a click ends the transition and follows that link itself.
      (() => {
        let active = null;
        addEventListener('pagereveal', (e) => {
          active = e.viewTransition;
          active?.finished.finally(() => (active = null));
        });
        document.addEventListener(
          'click',
          (e) => {
            const transition = document.activeViewTransition ?? active;
            if (!transition) return;
            transition.skipTransition();
            active = null;
            if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            const link = document.elementFromPoint(e.clientX, e.clientY)?.closest('a[href]');
            if (!link || e.target === link || link.contains(e.target)) return;
            e.preventDefault();
            link.click();
          },
          true,
        );
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <SkipLink label={site.labels.skipLink} />
    <Header currentPath={canonicalUrl(Astro.url).pathname} />
    <main id="main" tabindex="-1" class="mx-auto w-full max-w-(--page-width) flex-1 px-(--gutter)">
      <slot />
    </main>
    <Footer />
  </body>
</html>
