---
import { getEntry, render } from 'astro:content';
import { mdxComponents } from '@/components/mdx';
import ProseLayout from '@/layouts/ProseLayout.astro';
import { breadcrumbs, canonicalUrl, profilePage } from '@/lib/schema';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('[about] src/content/pages/about.mdx is missing.');
const { Content } = await render(about);
const pageUrl = canonicalUrl(Astro.url);
const jsonLd = [profilePage(pageUrl), breadcrumbs([{ name: about.data.title, url: pageUrl }])];
---

<ProseLayout
  title={about.data.title}
  description={about.data.description}
  updated={about.data.updated}
  type="profile"
  jsonLd={jsonLd}
>
  <Content components={mdxComponents} />
</ProseLayout>
