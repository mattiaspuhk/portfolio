---
import { getEntry, render } from 'astro:content';
import RadarBand from '@/components/apron/RadarBand.astro';
import Arrow from '@/components/site/Arrow.astro';
import Terminal from '@/components/apron/Terminal.astro';
import { mdxComponents } from '@/components/mdx';
import NoteItem from '@/components/notes/NoteItem.astro';
import ProofPoints from '@/components/work/ProofPoints.astro';
import { site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { byOrder, byPublishedDesc, getPublished } from '@/lib/content';
import { formatDate, isoDate } from '@/lib/format';

const work = (await getPublished('work')).sort(byOrder);
const proof = (await getPublished('proof')).sort(byOrder);
const notes = (await getPublished('notes')).sort(byPublishedDesc).slice(0, 3);
const now = await getEntry('pages', 'now');
const NowContent = now && (await render(now)).Content;
const { home: labels } = site.labels;

// The headline's last words take a line of their own and glow. If they aren't in the headline,
// nothing does.
const roleAt = labels.introTitle.lastIndexOf(labels.introTitleRole);
const headline = roleAt >= 0 ? labels.introTitle.slice(0, roleAt) : labels.introTitle;
const role = roleAt >= 0 ? labels.introTitleRole : '';
---

<BaseLayout title={site.name} description={site.description}>
  <div class="flex flex-col gap-[calc(var(--space-2xl)*1.5)] py-(--space-xl)">
    <section class="hero">
      <h1 class="headline" data-radar-clear>
        {headline}{role && <span class="headline-role halo" data-halo={role}>{role}</span>}
      </h1>
      <p class="hero-intro" data-radar-clear>{labels.intro}</p>
      {
        work.length > 0 && (
          <a class="hero-link" href="#home-work" data-radar-clear>
            {labels.seeWork}
            <Arrow direction="down" />
          </a>
        )
      }
      <RadarBand />
    </section>

    {
      work.length > 0 && (
        <section class="flex flex-col gap-(--space-xl)" aria-labelledby="home-work">
          <h2 id="home-work" class="apron-head">
            <a href="/work">{labels.work}</a>
          </h2>
          <Terminal entries={work} headingLevel={3} />
        </section>
      )
    }

    {
      proof.length > 0 && (
        <section class="flex flex-col gap-(--space-xl)" aria-labelledby="home-proof">
          <h2 id="home-proof" class="apron-head">
            {labels.proof}
          </h2>
          <ProofPoints items={proof} />
        </section>
      )
    }

    {
      now && NowContent && (
        <section class="flex flex-col gap-(--space-xl)" aria-labelledby="home-now">
          <h2 id="home-now" class="apron-head">
            <a href="/now">{labels.now}</a>
          </h2>
          <div class="apron-split">
            {now.data.updated && (
              <p class="text-sm text-muted">
                {site.labels.updated}{' '}
                <time datetime={isoDate(now.data.updated)}>{formatDate(now.data.updated)}</time>
              </p>
            )}
            <div class="prose text-lg md:col-start-2">
              <NowContent components={mdxComponents} />
            </div>
          </div>
        </section>
      )
    }

    {
      notes.length > 0 && (
        <section class="flex flex-col gap-(--space-xl)" aria-labelledby="home-notes">
          <h2 id="home-notes" class="apron-head">
            <a href="/notes">{labels.notes}</a>
          </h2>
          <ul class="apron-rows">
            {notes.map((entry) => (
              <li>
                <NoteItem entry={entry} headingLevel={3} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
