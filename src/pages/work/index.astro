---
import WorkCard from '@/components/work/WorkCard.astro';
import { site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { byOrder, getPublished } from '@/lib/content';

const work = (await getPublished('work')).sort(byOrder);
const { title, description } = site.pages.work;
---

<BaseLayout title={title} description={description}>
  <div class="flex flex-col gap-(--space-lg) py-(--space-lg)">
    <h1 class="text-3xl">{title}</h1>
    {
      work.length > 0 && (
        <ul class="flex flex-col gap-(--space-lg)">
          {work.map((entry) => (
            <li>
              <WorkCard entry={entry} />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
